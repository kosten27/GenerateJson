        "position": 1
      }
    ]
  },
  {
    "id": "5c702b0a-6f38-40a2-b81f-dc57d1f879a8",
    "themeId": "7123bf13-221d-4a3d-a3bf-13221d0a3df7",
    "sourceOrder": 2,
    "order": 2,
    "text": "Вкажіть найбільш поширені види тягово-зчіпних пристроїв вантажних транспортних засобів – тягачів.",
    "answerOptionList": [
      {
        "id": "3c28839d-b4fd-42b9-b7d6-42ed0305fcf1",
        "position": 1,
        "text": "Гачкові і безпроміжкові зі шкворнем.",
        "isCorrect": true
      },
      {
        "id": "c2509e0a-a3b1-44de-982d-9404d1bbe5d3",
        "position": 2,
        "text": "Кульові та шкворневі.",
        "isCorrect": false
      },
      {
        "id": "745f2ffc-26b0-4945-8340-2ba1c0fddf41",
        "position": 3,
        "text": "Безгачкові та із проміжком у шкворні.",
        "isCorrect": false
      }
    ]
  },
  {
    "id": "ffc8858a-d478-4a55-b177-7733683de48c",
    "themeId": "7123bf13-221d-4a3d-a3bf-13221d0a3df7",
    "sourceOrder": 3,
    "order": 3,
    "text": "За наявності якої несправності дозволяється експлуатація транспортного засобу?",
    "answerOptionList": [
      {
        "id": "40aa5080-8f34-41cd-97bb-3c3d84d914a5",
        "position": 1,
        "text": "Не працюють запори горловин паливних баків.",
        "isCorrect": false
      },
      {
        "id": "214afd9e-3bcd-42af-a617-c30105c7c16e",
        "position": 2,
        "text": "Не працює пристрій для обігрівання та обдування скла.",
        "isCorrect": false
      },
      {
        "id": "c0ddf440-c04d-4293-b376-1c53566d55c1",
        "position": 3,
        "text": "Не працює склопідйомник.",
        "isCorrect": true
      }
    ],
    "hintList": [
      {
        "id": "bd65da17-4b6f-4e70-b651-5d35aa86b1a2",
